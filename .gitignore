# --- Secrets: API keys live in .env, which must NEVER be committed ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- Raw downloads (may carry source licenses that forbid redistribution) ---
data/raw/*
!data/raw/.gitkeep
# Processed postings still contain the companies' full text, so they stay out too
data/processed/*
!data/processed/.gitkeep

# --- Model weights, LoRA adapters, caches: large and reproducible ---
models/
adapters/
*.safetensors
*.gguf
.cache/

# --- macOS / editors ---
.DS_Store
.vscode/
.idea/
